{
 "title": "Pick it with your thumb: widgets",
 "order": 8,
 "summary": "Controls the agent draws itself: drag ideas onto a grid, tap a screen, tune a colour. The answer is whatever JSON the control returns.",
 "description": "A `widget` is HTML and script written by the asking agent, shown in a locked box: no network, no access to this page. It hands back **one value**, and that value is the answer. Try the three below; each question shows the JSON it sends.",
 "fields": [
  {
   "type": "markdown",
   "group": "Place",
   "label": "How it works",
   "text": "The agent writes a small page and calls `askForm.setValue(value)` whenever the answer changes. Here the grid returns `{ \"dark-mode\": {\"x\": 30, \"y\": 80}, … }`, with `x` the effort and `y` the impact, both 0 to 100."
  },
  {
   "key": "priorities",
   "label": "Where do these ideas land?",
   "type": "widget",
   "schema": "object",
   "group": "Place",
   "height": 320,
   "help": "Effort left to right, impact bottom to top. Ideas you leave in the tray are left out of the answer.",
   "html": "<style>\n.plane{position:relative;height:236px;border:1px solid hsl(var(--border));border-radius:10px;touch-action:none;user-select:none;-webkit-user-select:none;\n background:linear-gradient(hsl(var(--border)),hsl(var(--border))) center/1px 100% no-repeat,linear-gradient(hsl(var(--border)),hsl(var(--border))) center/100% 1px no-repeat}\n.ax{position:absolute;font-size:11px;color:hsl(var(--muted-foreground));pointer-events:none}\n.chip{display:inline-block;padding:7px 12px;border-radius:999px;background:hsl(var(--primary));color:hsl(var(--primary-foreground));font-size:13px;cursor:grab;touch-action:none;white-space:nowrap;user-select:none;-webkit-user-select:none}\n.plane .chip{position:absolute;transform:translate(-50%,-50%)}\n.tray{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px;min-height:34px}\n.hint{margin:8px 0 0;font-size:12px;color:hsl(var(--muted-foreground))}\n</style>\n<div class=\"plane\" id=\"pl\">\n <span class=\"ax\" style=\"left:8px;top:5px\">▲ big impact</span>\n <span class=\"ax\" style=\"left:8px;bottom:5px\">▼ small impact</span>\n <span class=\"ax\" style=\"right:8px;bottom:5px\">more effort ▶</span>\n <span class=\"ax\" style=\"right:8px;top:5px\">hard, worth it</span>\n</div>\n<div class=\"tray\" id=\"tr\"></div>\n<p class=\"hint\">Drag ideas onto the grid; drop outside to undo.</p>\n<script>\n(function () {\n  var items = [[\"dark-mode\", \"Dark mode\"], [\"csv-export\", \"CSV export\"], [\"sso\", \"SSO login\"], [\"search\", \"Faster search\"]];\n  var pl = document.getElementById(\"pl\"), tr = document.getElementById(\"tr\"), val = {}, chips = {};\n  function clamp(n) { return Math.max(0, Math.min(100, n)); }\n  function at(c, x, y) { c.style.left = x + \"%\"; c.style.top = (100 - y) + \"%\"; }\n  function report() { askForm.setValue(Object.keys(val).length ? val : null); }\n  function pos(e) { var r = pl.getBoundingClientRect(); return { x: (e.clientX - r.left) / r.width * 100, y: 100 - (e.clientY - r.top) / r.height * 100 }; }\n  function down(e) {\n    var c = e.currentTarget;\n    pl.appendChild(c); // moving a node drops pointer capture: capture after\n    c.setPointerCapture(e.pointerId);\n    var p = pos(e); at(c, clamp(p.x), clamp(p.y));\n    c.onpointermove = function (ev) { var q = pos(ev); at(c, clamp(q.x), clamp(q.y)); };\n    c.onpointerup = function (ev) {\n      c.onpointermove = c.onpointerup = null;\n      var q = pos(ev);\n      if (q.x < -4 || q.x > 104 || q.y < -4 || q.y > 104) { c.removeAttribute(\"style\"); tr.appendChild(c); delete val[c.dataset.id]; }\n      else val[c.dataset.id] = { x: Math.round(clamp(q.x)), y: Math.round(clamp(q.y)) };\n      report();\n    };\n    e.preventDefault();\n  }\n  items.forEach(function (it) {\n    var c = document.createElement(\"div\");\n    c.className = \"chip\"; c.textContent = it[1]; c.dataset.id = it[0];\n    c.addEventListener(\"pointerdown\", down);\n    tr.appendChild(c); chips[it[0]] = c;\n  });\n  askForm.onInit(function (v) {\n    if (!v || typeof v !== \"object\") return;\n    Object.keys(v).forEach(function (id) {\n      if (!chips[id] || !v[id]) return;\n      pl.appendChild(chips[id]); at(chips[id], clamp(v[id].x), clamp(v[id].y)); val[id] = v[id];\n    });\n  });\n})();\n</script>"
  },
  {
   "key": "annoying",
   "label": "Tap the part of this screen that bothers you most",
   "type": "widget",
   "schema": "string",
   "group": "Point",
   "height": 352,
   "help": "The answer is the `data-id` of the thing you tapped, e.g. `compose`. Tap it again to clear.",
   "html": "<style>\nbody{display:flex;justify-content:center;padding:4px 0}\n.phone{width:250px;border:1px solid hsl(var(--border));border-radius:22px;overflow:hidden;background:hsl(var(--card));position:relative;box-shadow:0 2px 10px hsl(0 0% 0%/.08)}\n[data-id]{cursor:pointer;-webkit-tap-highlight-color:transparent}\n[data-id].on{outline:2px solid hsl(var(--primary));outline-offset:-2px;background:hsl(var(--primary)/.14)}\n.bar{display:flex;justify-content:space-between;align-items:center;padding:12px 14px;font-weight:600;background:hsl(var(--muted))}\n.search{margin:10px 12px;padding:9px 12px;border-radius:9px;border:1px solid hsl(var(--border));color:hsl(var(--muted-foreground));font-size:12.5px}\n.item{margin:0 12px 8px;padding:10px 12px;border-radius:10px;border:1px solid hsl(var(--border));font-size:12.5px}\n.item small{display:block;color:hsl(var(--muted-foreground));margin-top:2px}\n.fab{position:absolute;right:12px;bottom:58px;width:42px;height:42px;border-radius:50%;background:hsl(var(--primary));color:hsl(var(--primary-foreground));display:grid;place-items:center;font-size:22px}\n.tabs{display:flex;margin-top:64px;border-top:1px solid hsl(var(--border))}\n.tabs div{flex:1;text-align:center;padding:11px 0;font-size:12px}\n</style>\n<div class=\"phone\" id=\"ph\">\n <div class=\"bar\" data-id=\"header\"><span>Inbox</span><span data-id=\"avatar\">◉</span></div>\n <div class=\"search\" data-id=\"search\">Search messages…</div>\n <div class=\"item\" data-id=\"message-1\">Invoice #482<small>Today · 2 attachments</small></div>\n <div class=\"item\" data-id=\"message-2\">Trip to Lisbon<small>Yesterday</small></div>\n <div class=\"fab\" data-id=\"compose\">+</div>\n <div class=\"tabs\"><div data-id=\"tab-inbox\">Inbox</div><div data-id=\"tab-sent\">Sent</div><div data-id=\"tab-settings\">Settings</div></div>\n</div>\n<script>\n(function () {\n  var cur = null, ph = document.getElementById(\"ph\");\n  function show(id) {\n    [].forEach.call(ph.querySelectorAll(\".on\"), function (n) { n.classList.remove(\"on\"); });\n    cur = id;\n    var n = id && ph.querySelector('[data-id=\"' + id + '\"]');\n    if (n) n.classList.add(\"on\");\n  }\n  ph.addEventListener(\"click\", function (e) {\n    var n = e.target.closest(\"[data-id]\");\n    if (!n) return;\n    var id = n.getAttribute(\"data-id\");\n    show(id === cur ? null : id);\n    askForm.setValue(cur);\n  });\n  askForm.onInit(function (v) { if (typeof v === \"string\") show(v); });\n})();\n</script>"
  },
  {
   "key": "brand_colour",
   "label": "Tune the accent colour",
   "type": "widget",
   "schema": "string",
   "group": "Tune",
   "default": "#3b82f6",
   "help": "Returns a `#rrggbb` string, starting from the default `#3b82f6`.",
   "html": "<style>\nbody{padding:2px 0}\n.sw{height:84px;border-radius:12px;border:1px solid hsl(var(--border));display:flex;align-items:flex-end;justify-content:flex-end;padding:8px;box-sizing:border-box}\n.sw code{font:600 13px ui-monospace,Menlo,monospace;padding:3px 8px;border-radius:6px;background:rgb(255 255 255/.85);color:#111}\n.row{display:grid;grid-template-columns:22px 1fr 36px;align-items:center;gap:10px;margin-top:12px;font-size:12.5px;color:hsl(var(--muted-foreground))}\n.row output{text-align:right;font-variant-numeric:tabular-nums}\ninput[type=range]{width:100%;height:28px;margin:0}\n</style>\n<div class=\"sw\" id=\"sw\"><code id=\"hx\"></code></div>\n<div class=\"row\"><span>H</span><input type=\"range\" id=\"h\" min=\"0\" max=\"360\"><output id=\"ho\"></output></div>\n<div class=\"row\"><span>S</span><input type=\"range\" id=\"s\" min=\"0\" max=\"100\"><output id=\"so\"></output></div>\n<div class=\"row\"><span>L</span><input type=\"range\" id=\"l\" min=\"5\" max=\"95\"><output id=\"lo\"></output></div>\n<script>\n(function () {\n  var $ = function (i) { return document.getElementById(i); };\n  function hex(h, s, l) {\n    s /= 100; l /= 100;\n    var a = s * Math.min(l, 1 - l);\n    function f(n) { var k = (n + h / 30) % 12, c = l - a * Math.max(-1, Math.min(k - 3, 9 - k, 1)); return (\"0\" + Math.round(255 * c).toString(16)).slice(-2); }\n    return \"#\" + f(0) + f(8) + f(4);\n  }\n  function hsl(x) {\n    var r = parseInt(x.slice(1, 3), 16) / 255, g = parseInt(x.slice(3, 5), 16) / 255, b = parseInt(x.slice(5, 7), 16) / 255;\n    var mx = Math.max(r, g, b), mn = Math.min(r, g, b), l = (mx + mn) / 2, d = mx - mn, h = 0, s = 0;\n    if (d) {\n      s = d / (1 - Math.abs(2 * l - 1));\n      h = mx === r ? ((g - b) / d + 6) % 6 : mx === g ? (b - r) / d + 2 : (r - g) / d + 4;\n      h *= 60;\n    }\n    return [Math.round(h), Math.round(s * 100), Math.round(l * 100)];\n  }\n  function draw(send) {\n    var c = hex(+$(\"h\").value, +$(\"s\").value, +$(\"l\").value);\n    $(\"sw\").style.background = c; $(\"hx\").textContent = c;\n    $(\"ho\").textContent = $(\"h\").value; $(\"so\").textContent = $(\"s\").value; $(\"lo\").textContent = $(\"l\").value;\n    if (send) askForm.setValue(c);\n  }\n  [\"h\", \"s\", \"l\"].forEach(function (i) { $(i).addEventListener(\"input\", function () { draw(true); }); });\n  askForm.onInit(function (v) {\n    var p = hsl(/^#[0-9a-f]{6}$/i.test(v) ? v : \"#3b82f6\");\n    $(\"h\").value = p[0]; $(\"s\").value = p[1]; $(\"l\").value = Math.max(5, Math.min(95, p[2]));\n    draw(false);\n    if (/^#[0-9a-f]{6}$/i.test(v)) { $(\"sw\").style.background = v; $(\"hx\").textContent = v; } // show the exact value, not its HSL round trip\n  });\n  draw(false);\n})();\n</script>"
  }
 ]
}
