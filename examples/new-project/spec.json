     "label": "Next.js",
     "description": "Server rendering and API routes in one app"
    },
    {
     "value": "sveltekit",
     "label": "SvelteKit",
     "description": "Less code per screen, smaller bundles"
    },
    {
     "value": "astro",
     "label": "Astro + islands",
